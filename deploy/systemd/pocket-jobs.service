[Unit]
Description=Pocket Jobs — your job search from saved to hired
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-jobs
Group=pocket-jobs
ExecStart=/usr/local/bin/pocket-jobs
Environment=DATA_DIR=/var/lib/pocket-jobs
Environment=PORT=8080
Environment=BASE_URL=https://jobs.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-jobs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
